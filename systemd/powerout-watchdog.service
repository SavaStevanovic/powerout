[Unit]
Description=powerout watchdog (javlja kada agent prestane da se javlja)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
ExecStart=/opt/powerout/bin/powerout watchdog
# systemd sam čita config.toml (sa tokenima) kao root i daje ga samo ovom servisu
LoadCredential=config.toml:/etc/powerout/config.toml
DynamicUser=yes
StateDirectory=powerout-watchdog
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
